# ============================================================
# TechFix Manager - Frontend (variables de entorno)
# ============================================================

# URL del backend SOLO para el proxy del servidor (no lleva
# NEXT_PUBLIC_: el navegador nunca la ve).
# En local, si no se define, se usa http://localhost:5137.
# En Render/Railway/Koyeb, apuntala a la URL publica del backend,
# sin /api al final y sin barra final.
# API_URL=https://tu-backend.onrender.com

# Opcional (modo directo): si se define, el navegador llama al
# backend sin pasar por el proxy y el backend necesita CORS.
# NEXT_PUBLIC_API_URL=http://localhost:5137

# ============================================================
# Firebase — login / registro con Google
# ============================================================
# Estas claves son PUBLICAS (viajan al navegador): Firebase las
# necesita en el cliente. Se obtienen en la consola de Firebase:
#   Configuracion del proyecto -> Tus apps -> App web -> SDK setup
# Si faltan, el boton de Google se muestra deshabilitado.
#
# Ademas, en Firebase -> Authentication -> Settings -> Dominios
# autorizados, agregar el dominio donde corre el frontend
# (localhost ya viene; en Render: proyecto-almanaque.onrender.com).
#
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
